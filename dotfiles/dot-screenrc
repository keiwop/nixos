# bindkey "^[[20~" eval "split -v" "focus" "screen"  # F9
# bind s eval "split -v" "focus" "screen"            # Ctrl + A -> S

# # Focus next subterminal
# bindkey "^[[21~" focus      # F10
# bindkey "^@" focus          # Ctrl + Space
# bind ^I focus               # Ctrl + A -> Tab

# Detach the screen
bindkey "^[[24~" detach     # F12
bind d detach               # Ctrl + A -> D


# Allow for 256 colors
term screen-256color
truecolor on

# Focus follows mouse on split terminals
defmousetrack on

# Allow terminal scrollback
termcapinfo xterm* ti@:te@

# Exiting from editors restores the display
altscreen off

# Don't wait for a timed out display (ie: ssh disconnection)
nonblock on
defnonblock on

# Define the maximum scrollback lines
defscrollback 32768

# Detach the screen upon hangup
autodetach on

# Do not show a startup message
startup_message off

# Record a log of the activity
deflog off
logfile $HOME/.screenlogs/%2`_%H_%n_%t.log
logtstamp on
logtstamp after 300


# Auto-create windows on startup
chdir /_
screen -t "/_" 1
chdir /_/dev
screen -t "/_/dev" 2
chdir /_/src
screen -t "/_/src" 3
chdir /_/etc
screen -t "/_/etc" 4

