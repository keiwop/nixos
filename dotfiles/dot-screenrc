# Define some macros for use in the screenrc
backtick 0 0 0 whoami
backtick 1 5 5 sh -c 'uptime | sed "s|.*average: \(.*\)|\1|"'
backtick 2 1 1 date +%H:%M:%S


# https://www.gnu.org/software/screen/manual/screen.html#String-Escapes
hardstatus alwayslastline "%{=b 5;7} %0`@%H %= %-w%{=b 7;5} %n %t %{=b 5;7}%+w %= %{=b 5;7} %01` %{=b 7;5} %f %{=b 5;7} %2` %{-}"


# You can get the keycodes using "showkey -a"
# https://www.gnu.org/software/screen/manual/screen.html#Command-Summary

# Jump to the previous window
bindkey "^[OP" prev         # F1
bindkey "^[[1;7D" prev      # Ctrl + Alt + LeftArrow
bind p prev                 # Ctrl + A -> P

# Jump to the next window
bindkey "^[OQ" next         # F2
bindkey "^[[1;7C" next      # Ctrl + Alt + RigthArrow
bind n next                 # Ctrl + A -> N

# Create a new window
bindkey "^[OR" screen       # F3
bindkey "^[t" screen        # Alt + T
bind t screen               # Ctrl + A -> T

# Show windows list
bindkey "^[OS" windowlist   # F4
bind w screen               # Ctrl + A -> W

# Close all the windows and exit
bindkey "^[[1;2S" quit      # Shift + F4

# Reload the screen configuration
bindkey "^[[15~" source $HOME/.screenrc # F5
bind r source $HOME/.screenrc           # Ctrl + A -> R

# Set monitoring of the window
bindkey "^[[17~" monitor    # F6
bind m monitor              # Ctrl + A -> M

# Toggle logging for window (use deflog for new windows too)
bindkey "^[[18~" log        # F7
bindkey "^[l" log           # Alt + L
bind l log                  # Ctrl + A -> L

# FIXME: is it worth it?
