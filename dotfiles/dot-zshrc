# Print the duration given a number of milliseconds
# Example: 63123 returns 1:03.123
format_duration(){
    local duration=$1
    local millis=$(( $duration % 1000 ))
    local total_seconds=$(( $duration / 1000 ))

    if (( $total_seconds == 0 )); then
        printf "0.%03d" $millis
        return
    fi

    local hours=$(( $total_seconds / 3600 ))
    local minutes=$(( ( $total_seconds % 3600 ) / 60 ))
    local seconds=$(( $total_seconds % 60 ))

    if (( $hours > 0 )); then
        printf "%d:%02d:%02d.%03d" $hours $minutes $seconds $millis
    elif (( $minutes > 0 )); then
        printf "%d:%02d.%03d" $minutes $seconds $millis
    else
        printf "%d.%03d" $seconds $millis
    fi
}


# Format size in bytes to human readable KiB/MiB/GiB
format_size(){
    local bytes=$1

    if (( bytes <= 0 )); then
        printf "0 B"
        return
    fi

    local gib=$(( bytes / ( 1024 * 1024 * 1024 )))
    bytes=$(( bytes % ( 1024 * 1024 * 1024 )))
    local mib=$(( bytes / ( 1024 * 1024 )))
    bytes=$(( bytes % ( 1024 * 1024 )))
    local kib=$(( bytes / 1024 ))
    bytes=$(( bytes % 1024 ))

    # Small loss of precision with the fraction but I can live with it
    if (( gib > 0 )); then
        printf "%d.%d GiB" $gib $(( mib * 10 / 1024 ))
    elif (( mib > 0 )); then
        printf "%d.%d MiB" $mib $(( kib * 10 / 1024 ))
    elif (( kib > 0 )); then
        printf "%d.%d KiB" $kib $(( bytes * 10 / 1024 ))
    else
        printf "%d B" $bytes
    fi
}


# Set the terminal title (for termm, screen and tmux)
set_title(){
    if [[ -n $TERMM ]] || [[ "$TERM" == "screen"* ]] || [[ "$TERM" == "tmux"* ]]; then
        TERM_TITLE="$1"
        local cmd=(${=1})
        if [[ -z "${cmd[1]}" ]]; then
            small_title="${PWD##*/}"
            [[ -z "$small_title" ]] && small_title="/"
        elif [[ "${cmd[1]}" == "sudo" ]]; then
            small_title="${cmd[2]}"
        else
            small_title="${cmd[1]}"
        fi
        echo -ne "\033k${small_title}\033\\"
    fi
}


# Update variables used in the PROMPT or RPROMPT
