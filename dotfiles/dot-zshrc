# Check if the network is functionning
# Test the LAN by pinging the router, then the WAN by pinging a DNS server of Google
# Lastly, ping www.google.com to see if I can get through the DNS
check_network(){
    echo -n "LAN: "
    print_ping_state "192.168.1.1"

    echo -n "WAN: "
    print_ping_state "8.8.8.8"

    echo -n "DNS: "
    print_ping_state "www.google.com"
}


# Send a single ping and wait 2 seconds for the response
# If it came back, good for you
print_ping_state(){
    if (ping -W 2 -c 1 $1 &> /dev/null); then
        echo "OK"
    else
        echo "NOPE"
    fi
}


# Put the machine in suspend mode at the end of the timer
# The timer can be the first argument in seconds
machine_suspend(){
    declare -i timer
    timer=0
    if [[ $1 -ge 1 ]]; then
        timer=$1
    else
        timer=2222
    fi
    echo "Reducing screen brightness"
    echo 18000 | sudo tee /sys/class/backlight/intel_backlight/brightness
    echo "Sleeping in $timer seconds"
    sleep $timer
    systemctl suspend
    echo '\tGoing to sleep'
    echo '\tBye'
    sleep 2
}


# Print the hex value from a int passed as parameter
hexof(){
    if [[ -n $1 ]]; then
        if [[ $1 -le 0xff ]]; then
            printf "0x%02x\n" $1
        elif [[ $1 -le 0xffff ]]; then
            printf "0x%04x\n" $1
        else
            printf "0x%x\n" $1
        fi
    fi
}


# Compress the files passed as args in a .tar.gz
tar_compress(){
    #--create --gzip --same-permissions --verbose --file
    tar_flags="-czpvf"
    dir_name=$(basename $(pwd))

    if [[ -d $1 ]] && [[ -z $2 ]]; then
        gz_name=$1
        input_files=$1
    elif [[ -f $1 ]] && [[ -z $2 ]]; then
        gz_name=${1%%.*}
        input_files=$1
    else
        gz_name=$dir_name
        input_files=($@)
    fi

    gz_file=$gz_name.tar.gz
    if [[ -e $gz_file ]]; then
        gz_file=${gz_name}_$(date +"%Y%m%d_%H%M%S").tar.gz
    fi

    echo "Compressing files:"
    tar $tar_flags $gz_file $input_files
    echo -e "\nOutput file: ${gz_file}"
}


# Decompress the archives passed as args in separate dirs
tar_decompress(){
    tar_flags="-xzpvf"

    for gz_file in $@; do
        gz_name=${$(basename $gz_file)%%.*}

        gz_dir=$gz_name
        if [[ -e $gz_dir ]]; then
            gz_dir=${gz_name}_$(date +"%Y%m%d_%H%M%S")
        fi
        mkdir -p $gz_dir

        echo -e "\nUncompressing archive: ${gz_file}"
        tar $tar_flags $gz_file -C $gz_dir
        echo "Output dir: ${gz_dir}"
    done
}


# Clean up a bit the system
clean_system(){
    echo -e "\nCleaning system of unnecessary files (I hope)"
    df -h /
    local used_bytes_before=$(df --block-size=1 / | awk 'NR==2 {print $3}')

    if [[ $os_id == "arch" ]]; then
        echo -e "\nCleaning Pacman cache (keeping the last 2 versions)"
        sudo paccache -rk 2
    elif [[ $os_id == "nixos" ]]; then
        echo -e "\nRunning NixOS garbage collection (keeping generations of the last 30 days)"
        sudo nix-collect-garbage --delete-older-than 30d
    elif [[ $os_id == "debian" ]]; then
        echo -e "\nCleaning APT cache and removing orphaned packages"
        sudo apt clean
        sudo apt autoremove --purge
    fi

    echo -e "\nDeleting old logs"
    sudo find /var/log/journal -name "system@*.journal" -delete > /dev/null
    sudo find /var/log/journal -name "user-1000@*.journal" -delete > /dev/null

    echo -e "\nDeleting coredumps"
    sudo rm -f /var/lib/systemd/coredump/core.*

    if [[ "$1" == "--cache" ]]; then
        # TODO: I don't have chrome installed to check if it still works
        echo -e "\nDeleting google-chrome cache"
        find ~/.config/google-chrome*/Default/File\ System/0* -delete > /dev/null
        find ~/.cache/google-chrome*/Default/Cache -delete > /dev/null

        echo -e "\nDeleting firefox cache"
        find ~/.cache/mozilla/firefox/* -delete > /dev/null

        echo -e "\nDeleting files in ~/.cache"
        find ~/.cache/thumbnails -name "*.png" -delete > /dev/null
    fi

    echo -e "\nAll done!"
    df -h /
    local used_bytes_after=$(df --block-size=1 / | awk 'NR==2 {print $3}')
    local bytes_released=$(( $used_bytes_before - $used_bytes_after ))
    local space_released=$(format_size $bytes_released)
    echo "Space released on the system: $space_released"
}


