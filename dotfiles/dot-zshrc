zmodload zsh/datetime
typeset -g _preexec=$EPOCHREALTIME
# git prompt triples the boot time from 5ms to 15ms (worth it?)
update_prompt


# Function called right before a command is executed
preexec(){
    # Set the running command as the title
    set_title "$1"

    # _preexec stores the time before a command is executed
    _preexec=$EPOCHREALTIME
}


# Function called right after a command finished running
precmd(){
    # The two are used to calculate the duration of a command and print it in the RPROMPT
    local pretime="${_preexec%.*}${${_preexec#*.}:0:3}"
    local posttime="${EPOCHREALTIME%.*}${${EPOCHREALTIME#*.}:0:3}"

    rprompt_time=$(format_duration "$(( $posttime - $pretime ))")

    # When the last command is finished, set the current directory name as title
    set_title "${PWD##*/}"

    RPROMPT="%{$fg_bold[$prompt_user_color]%}%~${git_prompt} %{$fg[magenta]%}- %{$fg_bold[cyan]%}%n%{$fg_bold[magenta]%}:%{$fg[cyan]%}%m%{$fg[magenta]%}:%{$fg[blue]%}%l %{$fg[magenta]%}- %{$fg_bold[white]%}%T %{$fg[magenta]%}- %{$fg_bold[yellow]%}[$rprompt_time]%{$reset_color%}"
}


# Function called when we change the current directory
chpwd(){
    update_prompt
}


