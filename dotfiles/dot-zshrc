}


# Use the Internet connection from wifi/tethering and share it to a raspberry
# directly connected to the Ethernet jack (No need for Ethernet crossover cable)
enable_shared_internet(){
    sudo ip link set enp3s0 up
    sudo ip addr add 192.168.42.42/24 dev enp3s0
    sudo sysctl net.ipv4.ip_forward=1
    sudo iptables -t nat -A POSTROUTING -o wlan0 -j MASQUERADE
    sudo iptables -A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    sudo iptables -A FORWARD -i enp3s0 -o wlan0 -j ACCEPT

    sudo iptables -I INPUT -p udp --dport 67 -i enp3s0 -j ACCEPT
    sudo iptables -I INPUT -p udp --dport 53 -s 192.168.42.0/24 -j ACCEPT
    sudo iptables -I INPUT -p tcp --dport 53 -s 192.168.42.0/24 -j ACCEPT
}

disable_shared_internet(){
    sudo iptables -F
    sudo iptables -t nat -F
}

connect_shared_internet(){
    ip addr add 192.168.42.43/24 dev eth0
    ip link set eth0 up
    ip route add default via 192.168.42.42 dev eth0
}


check_honeypot(){
    if command -v endlessh > /dev/null 2>&1; then
        local pid=$(systemctl show endlessh --property=MainPID --value)
        local nb_conn=$(($(sudo ls /proc/$pid/fd | wc -l) - 4))
        echo "Users waiting endlessly: $nb_conn"
    fi
}


esprun(){
    if [[ -z $1 ]]; then
        echo "Undefined esphome config file"
        echo "Usage: esprun config_file [ip_address/tty_path]"
        exit 1
    fi
    docker exec -it esphome bash -c "rm -rf /config/{*.yaml,bkp,common,components,devices,ext_components,ui}"
    docker exec -it esphome bash -c "cp -a /src/* /config/"

    if [[ -z $2 ]]; then
        local device=/dev/ttyUSB0
    else
        local device=$2
    fi
    docker exec -it esphome esphome run $1 --device $device
}


