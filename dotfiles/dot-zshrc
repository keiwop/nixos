        git_prompt=$(git remote get-url origin 2>/dev/null | sed -E "s|.*/([^/]+)(\.git)|%{$fg[magenta]%}(%F{2}\1%{$fg[magenta]%}:|")
        git_prompt=$git_prompt$(git branch --show-current 2>/dev/null | sed "s|.*|%F{2}&%{$fg[magenta]%})|")
    else
        git_prompt=""
    fi
}


# This builtin is taking precedence over the screen binary
# If no args are given, then it auto-connects to the "main" session
screen(){
    # Pass arguments to the real screen program
    if [ $# -gt 0 ]; then
        command screen "$@"
        return
    fi
    # Check if "main" session exists
    if command screen -ls | grep -q "\.main"; then
        if command screen -ls | grep "\.main" | grep -qi "Dead"; then
            echo "Found dead screen session, wiping it"
            command screen -wipe
        else
            echo "Reconnecting to main screen session"
            command screen -d -r main
            return
        fi
    fi
    echo "Creating main screen session"
    command screen -S main
}

# Same as the screen builtin
tmux(){
    if [ $# -gt 0 ]; then
        echo "Using real tmux"
        command tmux "$@"
        return
    fi

    echo "Attaching or creating tmux session: main"
    # A: Attach to session (create if it doesn't exists)
    # D: Detach all other clients (In -A mode of new-session, -d of attach-session becomes -D)
    # X: Send SIGHUP to detached clients parent (In -A mode of new-session, -x of attach-session becomes -X)
    # s: Session name
    command tmux new-session -A -D -X -s main
}


